# Aqaab Subtide Lite - 4GB RAM profile
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ENABLE_WHISPER=true
ENABLE_DIARIZATION=false
ENABLE_VAD=false
WHISPER_MODEL=tiny
WHISPER_BEAM_SIZE=1
WHISPER_CONDITION_ON_PREVIOUS=false
WHISPER_CPU_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

CACHE_DIR=./cache
MODEL_CACHE_DIR=~/.cache/subtide-models
PORT=5001
